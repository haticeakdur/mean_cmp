############################################################
## 1) Helper functions for CMP_mu
############################################################

## 1.1 Truncation level (summax) consistent with mpcmp
cmp_resid_summax <- function(object) {
  y <- object$y
  
  if (!is.null(object$summax) &&
      length(object$summax) == 1L &&
      is.finite(object$summax)) {
    return(as.integer(object$summax))
  }
  
  vy <- stats::var(y)
  ceiling(max(c(max(y) + 20 * sqrt(vy), 100)))
}

## 1.2 CMP variance using a common truncation level
cmp_variance <- function(object) {
  smax <- cmp_resid_summax(object)
  V <- comp_variances(object$lambda, object$nu, object$log_Z, smax)
  V[V <= 0] <- min(V[V > 0])
  V
}

############################################################
## 2) Quantile-based residuals for CMP_mu
############################################################

## Randomized Quantile Residual (RQR)
rqres_from_cmp <- function(object, eps = 1e-10) {
  y <- object$y
  smax <- cmp_resid_summax(object)
  
  FL <- pcomp(y - 1, object$lambda, object$nu, summax = smax)
  FU <- pcomp(y,     object$lambda, object$nu, summax = smax)
  
  FL <- pmax(FL, eps)
  FU <- pmin(FU, 1 - eps)
  
  bad <- !is.finite(FL) | !is.finite(FU) | (FL >= FU)
  if (any(bad)) {
    mid <- pmin(pmax(FU[bad], eps), 1 - eps)
    FL[bad] <- pmax(mid - 1e-8, eps)
    FU[bad] <- pmin(mid + 1e-8, 1 - eps)
  }
  
  qnorm(runif(length(y), FL, FU))
}

## Adjusted Quantile Residual (AQR)
aqr_from_cmp <- function(object) {
  rq <- rqres_from_cmp(object)
  h  <- hatvalues(object)
  rq / sqrt(1 - h)
}

############################################################
## 3) Moment- and score-based residuals for CMP_mu
############################################################

## Anscombe residual
anscombe_from_cmp <- function(object, n.grid = 400) {
  mu <- object$fitted_values
  smax <- cmp_resid_summax(object)
  
  mu.grid <- seq(max(1e-6, min(mu) * 0.5),
                 max(mu) * 1.5, length.out = n.grid)
  
  lambda.grid <- splinefun(mu, object$lambda)(mu.grid)
  logZ.grid   <- splinefun(mu, object$log_Z)(mu.grid)
  
  V.grid <- comp_variances(lambda.grid, object$nu, logZ.grid, smax)
  V.grid[V.grid <= 0] <- min(V.grid[V.grid > 0])
  
  A.grid <- cumsum(c(0, diff(mu.grid) *
                       (1 / sqrt(V.grid[-length(V.grid)]) +
                        1 / sqrt(V.grid[-1])) / 2))
  
  Afun <- splinefun(mu.grid, A.grid)
  Afun(object$y) - Afun(mu)
}

## Williams residual
williams_from_cmp <- function(object) {
  mu <- object$fitted_values
  V  <- cmp_variance(object)
  h  <- hatvalues(object)
  
  rP <- (object$y - mu) / sqrt(V)
  phi <- V / mu
  den <- 1 - phi * h
  
  rW <- rP / sqrt(abs(den))
  rW[den <= 0] <- NA
  rW
}

## Dispersion–score residual
dispersion_score_from_cmp <- function(object) {
  smax <- cmp_resid_summax(object)
  
  mu <- comp_means(object$lambda, object$nu, object$log_Z, smax)
  B  <- comp_mean_logfactorialy(object$lambda, object$nu, object$log_Z, smax)
  Eylog <- comp_mean_ylogfactorialy(object$lambda, object$nu, object$log_Z, smax)
  V  <- comp_variances(object$lambda, object$nu, object$log_Z, smax)
  
  A <- Eylog - mu * B
  S <- A * (object$y - mu) / V - (lgamma(object$y + 1) - B)
  
  Z <- scale(S)
  as.numeric(Z)
}

############################################################
## 4) Unified residual extractor
############################################################

residuals.cmp_mu <- function(object, type) {
  switch(type,
         quantile         = rqres_from_cmp(object),
         adj_quantile     = aqr_from_cmp(object),
         anscombe         = anscombe_from_cmp(object),
         williams         = williams_from_cmp(object),
         dispersion_score = dispersion_score_from_cmp(object))
}

############################################################
## 5) Application: Takeover Bids Data
############################################################

data("takeoverbids")

form_bids <- numbids ~ leglrest + rearest + finrest + whtknght +
  bidprem + insthold + size + sizesq + regulatn

## Fit competing models (fixed effects only)
fit_pois <- glmmTMB(form_bids, data = takeoverbids, family = poisson)
fit_nb2  <- glmmTMB(form_bids, data = takeoverbids, family = nbinom2)
fit_gp   <- glmmTMB(form_bids, data = takeoverbids, family = genpois())
fit_bell <- glmmTMB(form_bids, data = takeoverbids, family = bell())

fit_cmp  <- glm.cmp(form_bids, data = takeoverbids)

############################################################
## 6) Randomized Quantile Residual comparison
############################################################

rqr_df <- bind_rows(
  tibble(Model = "Poisson", RQR = residuals(fit_pois, type = "dunn-smyth")),
  tibble(Model = "NB2",     RQR = residuals(fit_nb2,  type = "dunn-smyth")),
  tibble(Model = "GenPois", RQR = rqr_gp(takeoverbids$numbids,
                                        fitted(fit_gp),
                                        sigma(fit_gp))),
  tibble(Model = "Bell",    RQR = rqr_bell(takeoverbids$numbids,
                                          fitted(fit_bell))),
  tibble(Model = "CMP_mu",  RQR = rqres_from_cmp(fit_cmp))
) %>% drop_na()

ggplot(rqr_df, aes(sample = RQR)) +
  stat_qq(alpha = 0.6) +
  stat_qq_line(linetype = "dashed", colour = "red") +
  facet_wrap(~Model, scales = "free") +
  labs(title = "Randomized Quantile Residuals Across Count Models") +
  theme_minimal(base_size = 13)

############################################################
## 7) Diagnostic plots for CMP_mu residuals
############################################################

diag_df <- tibble(
  mu_hat = fit_cmp$fitted_values,
  leverage = hatvalues(fit_cmp),
  Pearson  = residuals(fit_cmp, type = "pearson"),
  Anscombe = anscombe_from_cmp(fit_cmp),
  Williams = williams_from_cmp(fit_cmp),
  DispersionScore = dispersion_score_from_cmp(fit_cmp)
) %>% pivot_longer(-c(mu_hat, leverage),
                   names_to = "Residual",
                   values_to = "Value")

ggplot(diag_df, aes(mu_hat, Value)) +
  geom_point(alpha = 0.5) +
  geom_smooth(se = FALSE) +
  geom_hline(yintercept = 0, linetype = "dashed") +
  facet_wrap(~Residual, scales = "free_y") +
  labs(title = "Residual Diagnostics for CMP_mu Model",
       x = expression(hat(mu))) +
  theme_minimal(base_size = 13)
